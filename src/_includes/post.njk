---
layout: base.njk
---
<article class="post">
  <div class="page-hero post-header">
    <div class="container prose">
      <p class="eyebrow"><a href="/insights/">Insights</a></p>
      <h1>{{ title }}</h1>
      <p class="post-meta">{{ page.date | readableDate }}</p>
    </div>
  </div>

  {% if cover %}
    <div class="container prose">
      <img class="post-cover" src="{{ cover }}" alt="">
    </div>
  {% endif %}

  <div class="container prose post-body">
    {{ content | safe }}
  </div>

  <div class="container prose post-nav">
    <a class="btn btn-ghost btn-sm" href="/insights/">← All Insights</a>
  </div>
</article>
